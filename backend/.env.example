# Run python ../scripts/setup_local.py to create .env with a random secret.
APP_ENV=development
DATABASE_URL=sqlite:///./trace.db
PUBLIC_ORIGIN=http://localhost:5173
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_MINUTES=120
COOKIE_SECURE=false
DATA_MODE=demo
# Reserved for future RAG / real model API module; not consumed by the starter.
AI_MODE=live
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
