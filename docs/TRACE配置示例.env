# TRACE V2.0 一期配置设计，应用代码需按此建立Settings。
# live为默认；当前未提供API密钥，不代表真实接入已经完成。
APP_ENV=development
API_WORKERS=1
APP_TIMEZONE=Asia/Shanghai
DATA_MODE=demo
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_URL=mysql+pymysql://trace_user:REPLACE_ME@localhost:3306/trace_phase1
JWT_SECRET=GENERATE_RANDOM_SECRET_LOCALLY
ACCESS_TOKEN_MINUTES=120
COOKIE_SECURE=false
DEMO_DATA_DIR=./data/demo/v1
