EMBEDDING_MODEL_REVISION=PIN_DOWNLOADED_REVISION
EMBEDDING_LOCAL_PATH=./artifacts/embedding
INDEX_ROOT=./artifacts/indexes
CHUNK_MAX_CHARS=300
CHUNK_OVERLAP_CHARS=40
RETRIEVAL_INITIAL_CHUNKS=30
RETRIEVAL_MAX_CHUNKS=60
RECOMMENDATION_LIMIT=5
AI_MODE=live
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL_ID=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_QUEUE_WAIT_SECONDS=5
AI_CONCURRENCY=1
AI_MAX_INPUT_CHARS=16000
AI_MAX_OUTPUT_TOKENS=4000
# 根据实际模型价格/请求上限填写，不能原样留空后启动live。
AI_INPUT_CNY_PER_MILLION_TOKENS=
AI_OUTPUT_CNY_PER_MILLION_TOKENS=
AI_MAX_COST_PER_CALL_CNY=
